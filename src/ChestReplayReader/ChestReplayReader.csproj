<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!--
      The assembly name must contain "ReplayReader": Unreal.Core only scans assemblies whose name
      contains that string for [PlayerController] / export-group attributes.
    -->
    <AssemblyName>ChestReplayReader</AssemblyName>
    <RootNamespace>ChestReplayReader</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Unreal.Core" Version="3.1.0" />
    <PackageReference Include="Unreal.Encryption" Version="3.1.0" />
  </ItemGroup>

</Project>
