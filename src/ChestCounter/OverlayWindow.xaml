<Window x:Class="ChestCounter.OverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Fortnite Chest Counter"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        ShowActivated="False"
        Focusable="False"
        ResizeMode="NoResize"
        SizeToContent="WidthAndHeight"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display"
        FontFamily="Segoe UI">

  <Window.Resources>
    <DropShadowEffect x:Key="TextShadow" ShadowDepth="1" BlurRadius="3" Opacity="0.9" Color="Black" />
  </Window.Resources>

  <Border x:Name="Card"
          CornerRadius="10"
          Padding="10,6,14,7"
          Background="#A6101318"
          BorderBrush="#40FFC83D"
          BorderThickness="1">
    <Border.LayoutTransform>
      <ScaleTransform x:Name="CardScale" ScaleX="1" ScaleY="1" />
    </Border.LayoutTransform>

    <Grid>
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>

      <!-- Chest icon -->
      <Viewbox Grid.Row="0" Grid.Column="0" Width="30" Height="30" Margin="0,2,9,0" VerticalAlignment="Center">
        <Canvas Width="24" Height="24">
          <Canvas.Effect>
            <DropShadowEffect ShadowDepth="1" BlurRadius="3" Opacity="0.8" Color="Black" />
          </Canvas.Effect>
          <!-- lid -->
          <Path Fill="#FF9A5B2E" Data="M2,10 L2,8 C2,4.7 4.7,3 8,3 L16,3 C19.3,3 22,4.7 22,8 L22,10 Z" />
          <!-- body -->
          <Rectangle Canvas.Left="2" Canvas.Top="10" Width="20" Height="11" RadiusX="1.2" RadiusY="1.2" Fill="#FF7A4322" />
          <!-- gold trim -->
          <Rectangle Canvas.Left="2" Canvas.Top="9.2" Width="20" Height="2" Fill="#FFFFC83D" />
          <Rectangle Canvas.Left="5" Canvas.Top="3.4" Width="1.6" Height="17.6" Fill="#FFE8A92A" />
          <Rectangle Canvas.Left="17.4" Canvas.Top="3.4" Width="1.6" Height="17.6" Fill="#FFE8A92A" />
          <!-- latch -->
          <Rectangle Canvas.Left="10" Canvas.Top="8" Width="4" Height="5.4" RadiusX="0.8" RadiusY="0.8" Fill="#FFFFE07A" Stroke="#FF7A4322" StrokeThickness="0.6" />
        </Canvas>
      </Viewbox>

      <!-- Total -->
      <StackPanel Grid.Row="0" Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
        <TextBlock x:Name="TotalText"
                   Text="0"
                   FontSize="30"
                   FontWeight="Bold"
                   Foreground="#FFFFD34D"
                   Effect="{StaticResource TextShadow}"
                   RenderTransformOrigin="0,0.6">
          <TextBlock.RenderTransform>
            <ScaleTransform x:Name="TotalScale" ScaleX="1" ScaleY="1" />
          </TextBlock.RenderTransform>
        </TextBlock>
        <TextBlock Text="chests"
                   FontSize="13"
                   FontWeight="SemiBold"
                   Foreground="#D9FFFFFF"
                   Margin="7,0,0,5"
                   VerticalAlignment="Bottom"
                   Effect="{StaticResource TextShadow}" />
        <TextBlock x:Name="PlusText"
                   Text="+1"
                   FontSize="15"
                   FontWeight="Bold"
                   Foreground="#FF7CFF8A"
                   Margin="8,0,0,0"
                   VerticalAlignment="Center"
                   Opacity="0"
                   Effect="{StaticResource TextShadow}">
          <TextBlock.RenderTransform>
            <TranslateTransform x:Name="PlusShift" Y="0" />
          </TextBlock.RenderTransform>
        </TextBlock>
      </StackPanel>

      <!-- This match / today -->
      <StackPanel x:Name="DetailRow" Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2" Orientation="Horizontal" Margin="1,1,0,0">
        <Ellipse x:Name="LiveDot" Width="7" Height="7" Fill="#FFFF4D4D" Margin="0,1,5,0" VerticalAlignment="Center" Visibility="Collapsed" />
        <TextBlock x:Name="DetailText"
                   Text=""
                   FontSize="12"
                   Foreground="#E6FFFFFF"
                   Effect="{StaticResource TextShadow}" />
      </StackPanel>

      <!-- Scanning progress / problems / move-mode hint -->
      <TextBlock x:Name="StatusText"
                 Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2"
                 Text=""
                 FontSize="11"
                 Foreground="#B3FFFFFF"
                 Margin="1,2,0,0"
                 MaxWidth="300"
                 TextWrapping="Wrap"
                 Visibility="Collapsed"
                 Effect="{StaticResource TextShadow}" />
    </Grid>
  </Border>
</Window>
